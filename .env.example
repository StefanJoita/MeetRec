# ============================================================
# .env.example — TEMPLATE pentru configurare
# ============================================================
# INSTRUCȚIUNI:
#   1. Copiază acest fișier: cp .env.example .env
#   2. Editează .env cu valorile reale
#   3. NICIODATĂ nu commita .env în Git!
# ============================================================

# --- POSTGRESQL ---
POSTGRES_HOST=postgres          # numele containerului Docker
POSTGRES_PORT=5432
POSTGRES_DB=meeting_transcriber
POSTGRES_USER=mt_user
POSTGRES_PASSWORD=change_me_in_production   # ← SCHIMBĂ ASTA!

# URL complet pentru SQLAlchemy async
# IMPORTANT: "postgresql+asyncpg://" (nu "postgresql://")
# Fără "+asyncpg" → eroare la startup: "Could not load backend 'asyncpg'"
DATABASE_URL=postgresql+asyncpg://mt_user:change_me_in_production@postgres:5432/meeting_transcriber

# --- VERSIUNE IMAGINI ---
# Tag-ul imaginilor meetrec/* (trebuie să corespundă pachetului offline încărcat cu docker load)
MEETREC_VERSION=1.2.0

# --- REDIS ---
# Redis cere parolă (--requirepass). docker-compose.yml construiește REDIS_URL din ea:
#   redis://:${REDIS_PASSWORD}@redis:6379/0
# Folosește doar caractere URL-safe (ex: openssl rand -hex 24).
REDIS_PASSWORD=change_me_redis_password
REDIS_TRANSCRIPTION_QUEUE=transcription_jobs

# --- STORAGE (NFS/NAS) ---
AUDIO_STORAGE_PATH=/data/processed
INBOX_PATH=/data/inbox
EXPORT_PATH=/data/exports
MAX_FILE_SIZE_BYTES=524288000   # 500MB

# --- STT WORKER (WhisperX) ---
# Modelul trebuie să fie cel descărcat și inclus în imagine de install/models/download-models.py
# (implicit large-v3). Schimbarea lui cere rebuild al imaginii stt-worker.
WHISPER_MODEL=large-v3
WHISPER_PRIMARY_LANGUAGE=ro
# Limbile recunoscute automat (altă limbă decât cea principală doar dacă e clar dominantă)
WHISPER_DETECT_LANGUAGES=ro,en
WHISPER_MODEL_PATH=/app/models
STT_WORKER_CONCURRENCY=1
# De câte ori poate cădea procesul (ex. memorie insuficientă) pe același fișier
# înainte ca înregistrarea să fie marcată 'failed' (retry manual din interfață).
MAX_JOB_ATTEMPTS=2
# Tipul de cuantizare pentru faster-whisper (int8 = cel mai rapid pe CPU)
WHISPER_COMPUTE_TYPE=int8
# Fire CPU pentru transcriere. 0 = toate nucleele serverului (implicit WhisperX: 4)
WHISPER_THREADS=0
# Oprește buclele de repetiție ale modelului (o frază repetată în locul vorbirii reale). 0 = dezactivat.
WHISPER_NO_REPEAT_NGRAM_SIZE=10

# --- DIARIZARE VORBITORI (opțional) ---
# Activează identificarea automată a vorbitorilor (SPEAKER_00, SPEAKER_01, ...)
# Modelul pyannote e inclus în imagine dacă a fost descărcat la pregătirea pachetului.
DIARIZATION_ENABLED=false
# Token HuggingFace — necesar DOAR pe mașina cu internet, pentru install/models/download-models.py.
# NU e folosit la runtime și NU trebuie copiat pe serverul offline.
# Obții tokenul de la: https://huggingface.co/settings/tokens
# Acceptă termenii modelului: https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=
# Număr minim/maxim de vorbitori (opțional — îmbunătățește acuratețea dacă știi)
MIN_SPEAKERS=
MAX_SPEAKERS=
# Diarizarea rulează în paralel cu transcrierea (jumătate din nuclee fiecare).
# false = una după alta. Peste N minute de audio rulează oricum una după alta (memorie).
DIARIZATION_PARALLEL=true
DIARIZATION_PARALLEL_MAX_MINUTES=180

# --- CĂUTARE DUPĂ SENS (search-indexer) ---
# Vectorul fiecărui segment include N segmente vecine de fiecare parte (context).
# La schimbare, toți vectorii se recalculează automat, în fundal.
EMBEDDING_CONTEXT_SEGMENTS=1

# --- API BACKEND ---
API_PORT=8080
# IMPORTANT: Generează o cheie secretă UNICĂ cu comanda de mai jos și înlocuiește VALOAREA_GENERATA:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NICIODATĂ nu folosi valoarea din acest fișier în producție!
JWT_SECRET_KEY=your-secret-key-min-32-chars-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480          # 8 ore (o zi de lucru)

# --- NGINX (Reverse Proxy) ---
NGINX_HTTPS_PORT=443
SERVER_NAME=meeting-transcriber.local

# --- IP-UL REAL AL CLIENTULUI (rate limiting, audit) ---
# Subnetul rețelei Docker frontend-network (nginx, frontend, API).
# Schimbă-l doar dacă se suprapune cu o rețea a organizației sau cu altă rețea Docker.
# După schimbare: docker compose down && docker compose up -d
FRONTEND_SUBNET=172.30.10.0/24
# IP-urile / subnetele (CIDR, separate prin virgulă) de la care API-ul acceptă
# X-Forwarded-For. Gol = FRONTEND_SUBNET (subnetul în care stă nginx).
# NU folosi "*": oricine ar putea falsifica IP-ul și ocoli limitele de login.
FORWARDED_ALLOW_IPS=

# --- NIVEL DE SECRETIZARE ---
# Afișat pe fiecare pagină a aplicației și în documentele exportate.
# Valoare inițială; se schimbă din Administrare → Setări.
CLASSIFICATION_LEVEL=NECLASIFICAT

# --- AUDIT & RETENȚIE ---
RETENTION_DAYS=1095             # 3 ani
AUDIT_LOG_RETENTION_DAYS=2190   # 6 ani
# Înregistrările „în transcriere” de peste N ore, fără job în coada Redis, devin 'failed'
STUCK_TRANSCRIPTION_HOURS=6
# Sesiunile pre-înregistrate care n-au primit niciun fișier audio valid în N ore sunt șterse
ABANDONED_SESSION_HOURS=24

# --- MEDIU ---
# production = /docs și /redoc dezactivate. Pentru dezvoltare: development.
APP_ENV=production
LOG_LEVEL=INFO
